{
  "name": "zzcalc",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && npm run build:worker",
    "build:worker": "esbuild worker/index.ts --bundle --format=esm --target=es2022 --platform=neutral --outfile=dist/_worker.js",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:worker": "vitest run --config worker/vitest.config.ts",
    "sim:pack": "node scripts/pack_sim_data.mjs",
    "cf:types": "wrangler types worker/worker-configuration.d.ts --include-runtime=false --include-main-module=false",
    "cf:dry-run": "npm run build",
    "cf:deploy": "npm run build && wrangler pages deploy dist --project-name zzzcalc --branch main",
    "ops:dry-run": "node scripts/publish_spec_update.mjs --dry-run",
    "ops:publish": "node scripts/publish_spec_update.mjs"
  },
  "devDependencies": {
    "@types/jsdom": "^28.0.3",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.5.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.14",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.22.1",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vitest": "^2.1.9",
    "wrangler": "^4.165.0"
  },
  "dependencies": {
    "@radix-ui/react-select": "^2.2.6",
    "chart.js": "^4.5.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "html2canvas": "^1.4.1",
    "lucide-react": "^1.16.0",
    "react": "^19.2.6",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.2.6",
    "tailwind-merge": "^3.6.0"
  }
}
